#!/bin/bash
# transcribe — офлайн-расшифровка видео: ffmpeg + whisper.cpp, без сети.
#
# Использование (из корня репозитория video-tools):
#   ./transcribe [опции] ПАПКА|ФАЙЛ [...]
#
# Папка обходится рекурсивно: можно передать сразу video/src проекта или даже
# несколько проектов. Расшифровка кладётся в каждую папку, где лежит видео.
#
# Примеры:
#   ./transcribe -n "/Volumes/potylitcyn/2026/10.11 - Спутник/video/src"   # план
#   ./transcribe -p "Привет, друзья! На связи Иван Потылицын." .../video/src
#   ./transcribe -n /Volumes/potylitcyn/2026/*/video/src    # все проекты года
#
# Раскладка результатов (в каждой папке с видео, всегда одинаковая):
#   камера/клип.MP4
#   камера/audio/клип.wav     звук из видео, WAV 16 кГц моно
#   камера/txt/клип.txt
#   камера/srt/клип.srt
#   камера/json/клип.json
#
# Звук всегда берётся из видео (дорожка с микрофона) и сохраняется как WAV
# 16 кГц моно — формат, на котором обучен Whisper. Папка audio, а не wav:
# в wav/ камера DJI кладёт свои WAV с теми же именами, а exFAT не различает
# регистр, так что клип.wav перезаписал бы клип.WAV. Чужой WAV скрипт не
# трогает никогда: если имя занято файлом другого формата — останавливается.
#
# Перед распознаванием работает VAD (Silero): Whisper получает только участки
# с речью и не выдумывает текст на тишине. Таймкоды сегментов whisper-cli
# возвращает в шкалу исходного файла сам, а таймкоды токенов в JSON — нет
# (баг whisper-cli 1.9.5), поэтому скрипт пересчитывает их по границам
# участков речи из лога whisper. Эти границы (в шкале исходного файла) тоже
# сохраняются в JSON, в поле "speech".
#
# Замены. После распознавания текст правится по спискам «замены.txt»: общему
# (рядом со скриптом) и проектным — скрипт ищет файл в папке клипа и во всех
# папках выше, так что его можно положить в video/ или video/src проекта.
# Формат строки: «неверно -> верно» или «вариант | вариант -> верно»,
# # — комментарий. Заменяются целые слова. txt и srt собираются из JSON,
# исходный текст whisper остаётся в JSON в поле "text_raw". Поэтому замены
# применяются и к готовым расшифровкам: поправил список — запусти скрипт
# снова, whisper при этом не запускается.
#
# Субтитры. Сегмент whisper длиннее 7 с или 90 знаков режется на куски по
# таймкодам токенов: по концам предложений, затем по запятым и словам. Края
# кусков подрезаются по участкам речи VAD. JSON при этом не меняется: нарезка,
# как и замены, делается при сборке txt/srt (postprocess.py, cut_segment).
#
# Клипы без звуковой дорожки (slow-mo, таймлапсы) пропускаются. Отдельные
# звуковые файлы рядом (.AAC у slow-mo Pocket 3) не используются: их
# таймкоды не совпадают с замедленным видео.
#
# Опции:
#   -l ЯЗЫК       язык речи (по умолчанию ru; auto — определить)
#   -p ТЕКСТ      подсказка whisper: термины, имена, стиль пунктуации
#   -f            пересчитать, даже если расшифровка уже есть
#   -n            только показать, что будет сделано
#   -h            эта справка
#
# Переменные окружения:
#   WHISPER_MODEL путь к модели (по умолчанию ~/whisper-models/ggml-large-v3-turbo.bin)
#   VAD_MODEL     путь к модели VAD (по умолчанию ~/whisper-models/ggml-silero-v6.2.0.bin)

set -u

LANG_CODE="ru"
PROMPT=""
FORCE=0
DRY=0
MODEL="${WHISPER_MODEL:-$HOME/whisper-models/ggml-large-v3-turbo.bin}"
VAD_MODEL="${VAD_MODEL:-$HOME/whisper-models/ggml-silero-v6.2.0.bin}"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
POST="$SCRIPT_DIR/postprocess.py"
GLOBAL_RULES="$SCRIPT_DIR/замены.txt"
VIDEO_EXT="mp4 mov m4v mkv mts mxf avi"

usage() { sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; }

while getopts "l:p:fnh" opt; do
  case "$opt" in
    l) LANG_CODE="$OPTARG" ;;
    p) PROMPT="$OPTARG" ;;
    f) FORCE=1 ;;
    n) DRY=1 ;;
    h) usage; exit 0 ;;
    *) usage; exit 2 ;;
  esac
done
shift $((OPTIND - 1))
[ $# -ge 1 ] || { usage; exit 2; }

# --- проверка инструментов -------------------------------------------------
missing=0
for bin in ffmpeg ffprobe whisper-cli python3; do
  command -v "$bin" >/dev/null 2>&1 || { echo "Нет $bin (см. «Установка» в README)" >&2; missing=1; }
done
[ -f "$MODEL" ] || { echo "Нет модели: $MODEL" >&2; missing=1; }
[ -f "$POST" ] || { echo "Нет $POST" >&2; missing=1; }
[ -f "$VAD_MODEL" ] || { echo "Нет модели VAD: $VAD_MODEL" >&2; missing=1; }
[ $missing -eq 0 ] || exit 1

TMP="$(mktemp -d "${TMPDIR:-/tmp}/transcribe.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT
trap 'echo; echo "Прервано." >&2; exit 130' INT TERM

shopt -s nullglob nocaseglob

# Видео в папке (без служебных ._ файлов exFAT), по одному на строку.
list_videos() {
  local dir="$1" ext f
  for ext in $VIDEO_EXT; do
    for f in "$dir"/*."$ext"; do
      case "$(basename "$f")" in ._*) continue ;; esac
      [ -f "$f" ] && echo "$f"
    done
  done | sort -u
}

# Существующий файл base.wav с любым регистром расширения.
find_wav() {
  local base="$1" f
  for f in "$base".[wW][aA][vV]; do
    [ -f "$f" ] && { echo "$f"; return; }
  done
}

duration() { ffprobe -v error -show_entries format=duration -of csv=p=0 "$1" 2>/dev/null | cut -d. -f1; }

# Пересчёт таймкодов токенов после VAD (баг whisper-cli 1.9.5, см. выше).
fix_vad_json() { python3 -I "$POST" vad "$1" "$2"; }

# Применить замены и собрать txt/srt из JSON. $1 — видео (пути через
# clip_paths), $2 — пусто или --check. Печатает число замен.
render() {
  python3 -I "$POST" render "$JSON" "$TXT" "$SRT" \
    --global "$GLOBAL_RULES" --dir "$(dirname "$1")" ${2:+"$2"}
}

# Прогресс-бар одного клипа из строк «progress = N%» whisper-cli (-pp).
# Читает stderr whisper, всё пишет в лог $1, полоску рисует в терминал.
progress_bar() {
  local log="$1" line p w=30 t0=$SECONDS bar rest eta
  while IFS= read -r line; do
    printf '%s\n' "$line"
    case "$line" in *"progress ="*) ;; *) continue ;; esac
    [ -t 2 ] || continue
    p="${line##*= }"; p="${p%\%}"; p="${p// /}"
    case "$p" in ''|*[!0-9]*) continue ;; esac
    bar="$(printf '%*s' $(( p * w / 100 )) '')"; bar="${bar// /█}"
    rest="$(printf '%*s' $(( w - p * w / 100 )) '')"; rest="${rest// /░}"
    eta=""
    [ "$p" -gt 0 ] && [ "$p" -lt 100 ] && eta="  ещё ~$(fmt_time $(( (SECONDS - t0) * (100 - p) / p )))"
    printf '\r\033[K      %s%s %3d%%%s' "$bar" "$rest" "$p" "$eta" >&2
  done > "$log"
  [ -t 2 ] && printf '\r\033[K' >&2
  return 0
}

fmt_time() {
  if [ "$1" -ge 3600 ]; then
    printf "%d:%02d:%02d" $(( $1 / 3600 )) $(( $1 % 3600 / 60 )) $(( $1 % 60 ))
  else
    printf "%d:%02d" $(( $1 / 60 )) $(( $1 % 60 ))
  fi
}

has_audio() {
  [ -n "$(ffprobe -v error -select_streams a:0 -show_entries stream=index -of csv=p=0 "$1" 2>/dev/null)" ]
}

# Все папки внутри $1 (включая её саму), без скрытых и служебных ._ папок.
list_dirs() {
  { echo "$1"; find "$1" -mindepth 1 \( -type d -name '.*' -prune \) -o \( -type d -print \); } | sort
}

# --- проход 1: план --------------------------------------------------------
# Пути результатов для видео $1 → переменные NAME TXT SRT JSON WAVBASE.
clip_paths() {
  local dir stem
  dir="$(cd "$(dirname "$1")" && pwd)"
  NAME="$(basename "$1")"; stem="${NAME%.*}"
  WAVBASE="$dir/audio/$stem"
  TXT="$dir/txt/$stem.txt"; SRT="$dir/srt/$stem.srt"; JSON="$dir/json/$stem.json"
}

# Решает судьбу клипа и ставит его в очередь. $1 — видео, $2 — корень
# аргумента (для печати), $3 — путь относительно корня.
# Печатает строку о клипе только с -n; ошибки — всегда.
plan_clip() {
  local video="$1" root="$2" rel="$3" wav fmt source dur
  clip_paths "$video"

  # txt и srt бывают пустыми законно: в клипе нет речи.
  if [ $FORCE -eq 0 ] && [ -f "$TXT" ] && [ -f "$SRT" ] && [ -s "$JSON" ]; then
    SKIPPED=$((SKIPPED + 1)); D_SKIP=$((D_SKIP + 1))
    if render "$video" --check >/dev/null; then
      [ $DRY -eq 1 ] && echo "  = $NAME — уже расшифрован"
    else
      [ $DRY -eq 1 ] && echo "  = $NAME — уже расшифрован, txt/srt пересоберутся"
      printf "%s\n" "$video" >> "$RERENDER"
    fi
    return 0
  fi

  if ! has_audio "$video"; then
    [ $DRY -eq 1 ] && echo "  - $NAME — в видео нет звука, пропускаю"
    NOAUDIO=$((NOAUDIO + 1)); D_NOAUDIO=$((D_NOAUDIO + 1))
    return 0
  fi

  # Звук: либо наш готовый WAV 16 кГц моно, либо извлечь из видео.
  wav="$(find_wav "$WAVBASE")"
  if [ -n "$wav" ]; then
    fmt="$(ffprobe -v error -select_streams a:0 -show_entries stream=codec_name,sample_rate,channels -of csv=p=0 "$wav")"
    if [ "$fmt" != "pcm_s16le,16000,1" ]; then
      echo "  ! $NAME — имя занято чужим файлом $wav ($fmt), не перезаписываю" >&2
      FAILED=$((FAILED + 1)); fail=1
      return 0
    fi
    source="звук уже извлечён"
  else
    source="звук из видео"
  fi

  dur="$(duration "$video")"; dur="${dur:-0}"
  [ $DRY -eq 1 ] && echo "  > $NAME ($(fmt_time "$dur"), $source)"
  printf "%s\t%s\t%s\t%s\n" "$dur" "$root" "$rel" "$video" >> "$QUEUE"
  TODO=$((TODO + 1)); TODO_SEC=$((TODO_SEC + dur)); D_TODO=$((D_TODO + 1))
}

plan_dir() {
  local dir="$1" root="$2" videos count v
  videos="$(list_videos "$dir")"
  [ -n "$videos" ] || return 0
  count=$(printf "%s\n" "$videos" | wc -l | tr -d ' ')
  FOUND=$((FOUND + count))
  D_TODO=0 D_SKIP=0 D_NOAUDIO=0
  [ $DRY -eq 1 ] && echo "$dir: видео $count"
  while IFS= read -r v; do
    plan_clip "$v" "$root" "${v#"$root"/}" </dev/null
  done <<< "$videos"
  [ $DRY -eq 1 ] || echo "$dir: видео $count — к расшифровке $D_TODO, готово $D_SKIP, без звука $D_NOAUDIO"
}

# --- проход 2: распознавание -----------------------------------------------
# $1 — видео. Возвращает 1 при ошибке.
transcribe_clip() {
  local video="$1" wav out="$TMP/out"
  REPL=0
  clip_paths "$video"
  wav="$(find_wav "$WAVBASE")"; wav="${wav:-$WAVBASE.wav}"

  mkdir -p "$(dirname "$wav")" "$(dirname "$TXT")" "$(dirname "$SRT")" "$(dirname "$JSON")"

  if [ ! -f "$wav" ]; then
    ffmpeg -hide_banner -loglevel error -nostdin -y -i "$video" -map 0:a:0 \
      -vn -ar 16000 -ac 1 -c:a pcm_s16le "$wav.part.wav" \
      && mv "$wav.part.wav" "$wav" \
      || { echo "    ! не удалось извлечь звук" >&2; rm -f "$wav.part.wav"; return 1; }
  fi

  # Результаты сначала во временную папку, потом на место.
  # Без -np: из лога нужны границы участков речи (vad_segment_info).
  # txt и srt собирает render из JSON — уже с заменами.
  local args=(-m "$MODEL" -l "$LANG_CODE" -f "$wav" --vad -vm "$VAD_MODEL"
              -pp -ojf -of "$out")
  # --carry-initial-prompt: подсказка действует на весь клип, а не только
  # на первые минуту-две, пока её не вытеснит распознанный текст.
  [ -n "$PROMPT" ] && args+=(--prompt "$PROMPT" --carry-initial-prompt)
  rm -f "$out".*
  whisper-cli "${args[@]}" 2>&1 >/dev/null | progress_bar "$TMP/whisper.log"
  [ "${PIPESTATUS[0]}" -eq 0 ] \
    || { echo "    ! whisper-cli завершился с ошибкой:" >&2; tail -5 "$TMP/whisper.log" >&2; return 1; }
  fix_vad_json "$out.json" "$TMP/whisper.log" \
    || { echo "    ! не удалось пересчитать таймкоды токенов" >&2; return 1; }

  mv "$out.json" "$JSON" \
    || { echo "    ! не удалось сохранить результаты" >&2; return 1; }
  REPL="$(render "$video")" \
    || { echo "    ! не удалось применить замены и собрать txt/srt" >&2; return 1; }
}

# --- обход аргументов ------------------------------------------------------
fail=0 FOUND=0 DONE=0 SKIPPED=0 NOAUDIO=0 FAILED=0 TODO=0 TODO_SEC=0
D_TODO=0 D_SKIP=0 D_NOAUDIO=0
QUEUE="$TMP/queue"; : > "$QUEUE"
RERENDER="$TMP/rerender"; : > "$RERENDER"

for arg in "$@"; do
  arg="${arg%/}"; arg="${arg:-/}"
  if [ -d "$arg" ]; then
    before=$FOUND
    while IFS= read -r d; do
      plan_dir "$d" "$arg"
    done < <(list_dirs "$arg")
    [ $FOUND -gt $before ] || echo "$arg: видео не найдено"
  elif [ -f "$arg" ]; then
    FOUND=$((FOUND + 1))
    plan_clip "$arg" "$(dirname "$arg")" "$(basename "$arg")" </dev/null
  else
    echo "$arg: нет такого файла или папки" >&2; fail=1
  fi
done

echo
NRE=$(wc -l < "$RERENDER" | tr -d ' ')
echo "План: расшифровать $TODO ($(fmt_time $TODO_SEC) видео), уже готово $SKIPPED (пересоберутся txt/srt: $NRE), без звука $NOAUDIO, ошибок $FAILED"
[ $DRY -eq 1 ] && exit $fail

# Готовые клипы, у которых изменятся txt/srt (списки замен, правила
# нарезки): whisper не нужен.
if [ "$NRE" -gt 0 ]; then
  while IFS= read -r video; do
    clip_paths "$video"
    render "$video" >/dev/null </dev/null \
      || { echo "  ! $NAME — не удалось пересобрать txt/srt" >&2; FAILED=$((FAILED + 1)); fail=1; }
  done < "$RERENDER"
  echo "Пересобраны txt/srt готовых клипов: $NRE"
fi

n=0 done_sec=0 t_start=$SECONDS last_root=""
while IFS=$'\t' read -r dur root rel video; do
  n=$((n + 1))
  if [ "$root" != "$last_root" ]; then echo; echo "$root"; last_root="$root"; fi
  echo "  [$n/$TODO] $rel ($(fmt_time "$dur"))"
  t0=$SECONDS
  if transcribe_clip "$video" </dev/null; then
    DONE=$((DONE + 1)); status="за $((SECONDS - t0)) с"
    [ "${REPL:-0}" -gt 0 ] && status="$status, замен $REPL"
  else
    FAILED=$((FAILED + 1)); fail=1; status="ОШИБКА"
  fi
  done_sec=$((done_sec + dur))
  left=$((TODO - n)); left_sec=$((TODO_SEC - done_sec)); elapsed=$((SECONDS - t_start))
  eta=""
  if [ $left -gt 0 ] && [ $done_sec -gt 0 ] && [ $elapsed -gt 0 ]; then
    eta=", ещё ~$(fmt_time $(( left_sec * elapsed / done_sec )))"
  fi
  echo "      $status · готово $n из $TODO, $(fmt_time $done_sec) из $(fmt_time $TODO_SEC) видео · осталось $left, $(fmt_time $left_sec)$eta"
done < "$QUEUE"

echo
echo "Итого: расшифровано $DONE за $(fmt_time $((SECONDS - t_start))), уже было $SKIPPED, без звука $NOAUDIO, ошибок $FAILED"
exit $fail
